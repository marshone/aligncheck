# .kzio.env
# .kzio.env.local (gitignore'd) for local/personal overrides

# Kzio container tools minimal version
KZIO_CONTAINER_MIN_VERSION=0.9.0

# Container registry (change to your own)
CONTAINER_REGISTRY=""

# Container image (org/repo:tag format)
CONTAINER_IMAGE="kzio.io/golang:1.27-1005"

# Container name prefix / app identifier (used in container name, volumes, etc.)
#CONTAINER_APPNAME="kzio_dev"

# Default workspace mount point inside container
#CONTAINER_WORKSPACE="/workspace"

# Specify container env
CONTAINER_ENV[GOBIN]=/home/devuser/.local/bin

# Enable / Disable features (defaults true)
# KZIO_FEATURE_HOME_VOLUME=true
# KZIO_FEATURE_BASHD_COMPLETION=true
# KZIO_FEATURE_INSPECT=true
